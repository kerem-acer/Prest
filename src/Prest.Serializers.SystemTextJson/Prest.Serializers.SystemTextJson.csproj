<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net8.0</TargetFrameworks>
    <RootNamespace>Prest.Serializers.SystemTextJson</RootNamespace>
  </PropertyGroup>

  <!-- NuGet package metadata -->
  <PropertyGroup>
    <PackageId>Prest.Serializers.SystemTextJson</PackageId>
    <Title>Prest — System.Text.Json converters</Title>
    <Description>System.Text.Json converters for Prest's pooled collection types: PooledArray&lt;T&gt;, PooledList&lt;T&gt;, PooledHashMap, and PooledHashSet. Includes PooledTypesJsonConverterFactory — a single registration that covers every closed generic for any algorithm. Requires net8.0+ for IUtf8SpanFormattable.</Description>
    <PackageTags>pool;json;systemtextjson;converter;serialization;hashmap;hashset;prest</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Prest\Prest.csproj" />
    <PackageReference Include="System.Text.Json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Prest.Serializers.SystemTextJson.Tests" />
  </ItemGroup>

</Project>

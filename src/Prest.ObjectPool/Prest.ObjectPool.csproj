<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net8.0;netstandard2.1;netstandard2.0</TargetFrameworks>
    <RootNamespace>Prest.ObjectPool</RootNamespace>
    <PackageId>Prest.ObjectPool</PackageId>
    <Description>Microsoft.Extensions.ObjectPool-based accessor for Prest's PooledBufferWriter. Use when pooling must survive await boundaries.</Description>
    <PackageTags>pool;bufferwriter;objectpool</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Prest\Prest.csproj" />
    <PackageReference Include="Microsoft.Extensions.ObjectPool" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Prest.ObjectPool.Tests" />
  </ItemGroup>

</Project>

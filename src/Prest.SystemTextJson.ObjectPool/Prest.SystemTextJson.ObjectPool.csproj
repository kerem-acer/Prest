<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net8.0;netstandard2.1;netstandard2.0</TargetFrameworks>
    <RootNamespace>Prest.SystemTextJson.ObjectPool</RootNamespace>
  </PropertyGroup>

  <!-- NuGet package metadata -->
  <PropertyGroup>
    <PackageId>Prest.SystemTextJson.ObjectPool</PackageId>
    <Title>Prest — await-safe PooledJsonBufferWriter</Title>
    <Description>Microsoft.Extensions.ObjectPool-backed accessor for PooledJsonBufferWriter. Use when the writer must survive an await boundary — the threadstatic cache in Prest.SystemTextJson is bound to a single thread.</Description>
    <PackageTags>pool;json;systemtextjson;objectpool;await;utf8jsonwriter;prest</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Prest.SystemTextJson\Prest.SystemTextJson.csproj" />
    <PackageReference Include="Microsoft.Extensions.ObjectPool" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Prest.SystemTextJson.ObjectPool.Tests" />
  </ItemGroup>

</Project>

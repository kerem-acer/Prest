<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net8.0;netstandard2.1;netstandard2.0</TargetFrameworks>
    <RootNamespace>Prest.Serializers.VYaml</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- NuGet package metadata -->
  <PropertyGroup>
    <PackageId>Prest.Serializers.VYaml</PackageId>
    <Title>Prest — VYaml formatters</Title>
    <Description>VYaml formatters for Prest's pooled collection types: PooledArray&lt;T&gt;, PooledList&lt;T&gt;, PooledHashMap, and PooledHashSet. Includes PooledTypeFormatterResolver — a single resolver registration covers every closed generic for any algorithm.</Description>
    <PackageTags>pool;yaml;vyaml;formatter;serialization;hashmap;hashset;prest</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Prest\Prest.csproj" />
    <PackageReference Include="VYaml" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Prest.Serializers.VYaml.Tests" />
  </ItemGroup>

</Project>
